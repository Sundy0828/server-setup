# NGINX Proxy Manager Database (must match what MySQL was initialized with)
MYSQL_ROOT_PASSWORD=npm-root-pass
MYSQL_PASSWORD=npm-pass

# NPM 2.13+ initial admin (used only when no users exist yet)
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=changeme

# Authelia SSO Configuration
# Generate these values with: openssl rand -base64 32
AUTHELIA_JWT_SECRET=your-jwt-secret-here
AUTHELIA_SESSION_SECRET=your-session-secret-here
AUTHELIA_STORAGE_ENCRYPTION_KEY=your-encryption-key-here

# Authelia SMTP Configuration (for password reset emails)
# Leave blank to disable email notifications
AUTHELIA_NOTIFIER_SMTP_HOST=smtp.gmail.com
AUTHELIA_NOTIFIER_SMTP_PORT=587
AUTHELIA_NOTIFIER_SMTP_USERNAME=jerrod.sunderland@gmail.com
AUTHELIA_NOTIFIER_SMTP_PASSWORD=your-app-password
AUTHELIA_NOTIFIER_SMTP_SENDER=authelia@yourdomain.com
