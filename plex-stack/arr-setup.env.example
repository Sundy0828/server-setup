# Copy to arr-setup.env and fill in your values.
# arr-setup.env is gitignored — safe to store passwords here.

# qBittorrent web UI password (required for download client setup)
# Check the first-run logs if you haven't changed it yet:
#   docker logs qbittorrent 2>&1 | Select-String password   # PowerShell
#   docker logs qbittorrent 2>&1 | grep -i password          # bash/Linux
QB_PASSWORD=

# Optional: override default username (default: admin)
# QB_USERNAME=admin

# Rutracker credentials (free account at rutracker.org)
# Set both to auto-add Rutracker as a Prowlarr indexer — great for music
RUTRACKER_USER=
RUTRACKER_PASS=

# Optional: override media paths inside containers (defaults shown)
# TV_PATH=/data/media/tv
# MOVIES_PATH=/data/media/movies
# MUSIC_PATH=/data/media/music
# BOOKS_PATH=/data/media/books

# Optional: override service URLs if ports differ from compose.yml
# SONARR_URL=http://localhost:8989
# RADARR_URL=http://localhost:7878
# LIDARR_URL=http://localhost:8686
# READARR_URL=http://localhost:8787
# PROWLARR_URL=http://localhost:9696
# BAZARR_URL=http://localhost:6767

# Optional: override Docker container names (used in inter-service config)
# SONARR_HOST=sonarr
# RADARR_HOST=radarr
# PROWLARR_HOST=prowlarr
# QBIT_HOST=gluetun
# FLARESOLVERR_HOST=flaresolverr

# Set to 1 to skip download client setup entirely (no password prompt)
# SKIP_QBIT=0
