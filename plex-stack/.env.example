TZ=America/New_York
PUID=1000
PGID=1000

# Path to your media/data directory on the host.
# Defaults to ./data (relative to this directory) if not set.
# On a server with a dedicated media disk, set this to the mount point:
#   DATA_PATH=/mnt/media
# Run ./setup.sh to populate .env interactively instead of editing manually.
DATA_PATH=

# Paths to your audiobook/music libraries on the host (used by Plex + Audiobookshelf).
#   AUDIOBOOKS_PATH=/mnt/media/audiobooks
#   MUSIC_PATH=/mnt/media/music
AUDIOBOOKS_PATH=
MUSIC_PATH=

# Plex claim token (optional on first startup)
# Get one at https://www.plex.tv/claim/
PLEX_CLAIM=

# Gluetun VPN settings
# See https://github.com/qdm12/gluetun-wiki for all supported providers
VPN_SERVICE_PROVIDER=protonvpn
# OpenVPN (ProtonVPN, NordVPN, etc.) — get credentials from your provider's dashboard
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
# WireGuard alternative — uncomment and fill if using a WireGuard provider instead
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=10.x.x.x/32

# qBittorrent WebUI credentials (used by port-forward sidecar)
QBT_USERNAME=admin
QBT_PASSWORD=

# Tailscale auth key for Overseerr sidecar
TS_AUTHKEY=
TS_HOSTNAME=overseerr-media

# Optional: SABnzbd host UI port (container web UI is always 8080)
SABNZBD_WEBUI_PORT=8085
