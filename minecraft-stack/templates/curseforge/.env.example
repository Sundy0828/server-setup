TZ=America/New_York
MC_CONTAINER_NAME=minecraft-my-server
MC_PORT=25565
MC_TYPE=AUTO_CURSEFORGE
MC_VERSION=LATEST
MC_MEMORY=8G
MC_GAMEMODE=survival
MC_DIFFICULTY=normal
MC_MAX_PLAYERS=20
MC_MOTD=A Modded Minecraft Server
MC_PVP=true
MC_ENABLE_WHITELIST=false

# CurseForge modpack page URL (required):
# Example: https://www.curseforge.com/minecraft/modpacks/all-the-mods-9
CF_PAGE_URL=
# CurseForge API key (required): create at https://console.curseforge.com/
CF_API_KEY=

# Optional: playit.gg tunnel for remote access without port-forwarding.
# Enable: docker compose --profile playit up -d
PLAYIT_CONTAINER_NAME=playit-my-server
PLAYIT_SECRET_KEY=
