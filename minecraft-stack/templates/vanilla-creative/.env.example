TZ=America/New_York
MC_CONTAINER_NAME=minecraft
MC_PORT=25565
MC_TYPE=VANILLA
MC_VERSION=LATEST
MC_MEMORY=3G
MC_GAMEMODE=creative
MC_DIFFICULTY=peaceful
MC_MAX_PLAYERS=20
MC_MOTD=Jerrod - Creative
MC_PVP=false
MC_HARDCORE=false
MC_ENABLE_WHITELIST=false

# CurseForge (only used when MC_TYPE=AUTO_CURSEFORGE):
CF_PAGE_URL=
CF_API_KEY=

# Optional: playit.gg tunnel for remote access without port-forwarding.
# Enable: docker compose --profile playit up -d
PLAYIT_CONTAINER_NAME=playit-my-server
PLAYIT_SECRET_KEY=
